{
  "name": "gladys-azure-devops",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for Azure DevOps (Services or Server): projects as devices, pipeline runs, pull requests and work items in scenes, dashboard widgets.",
  "homepage": "https://github.com/William-De71/gladys-azure-devops",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-azure-devops.git"
  },
